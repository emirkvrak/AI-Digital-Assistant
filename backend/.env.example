# Uygulama ayarları
SECRET_KEY=replace-with-a-long-random-local-secret
IS_PRODUCTION=false
LOG_LEVEL=INFO

# Veritabanı
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=chatbot

# Uygulama adresleri
FRONTEND_URL=http://127.0.0.1:5173
MODEL_API_URL=http://127.0.0.1:5005

# Token kullanım süreleri
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
VERIFY_EMAIL_TOKEN_EXPIRE_MINUTES=60
RESET_PASSWORD_TOKEN_EXPIRE_MINUTES=60

# Lokal sahte e-posta sunucusu (Mailpit)
MAIL_SERVER=127.0.0.1
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@ai-digital-assistant.local
MAIL_TIMEOUT=10

# İsteğe bağlı dış servisler
ASSEMBLY_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
